# ==========================================
# MaintSync Spring Boot Backend Environment Variables
# ==========================================

# Server Port & CORS
SERVER_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maintenance_db
DB_USER=root
DB_PASS=your_mysql_password_here

# JWT Secret & Expiration
# Must be a 256-bit (32-byte) or longer base64-encoded string
JWT_SECRET=your_32_byte_or_longer_secret_here
JWT_EXPIRATION_MS=604800000

# OAuth2 - Google Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth2 - GitHub Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Frontend OAuth2 Redirect Target
OAUTH2_REDIRECT_URI=http://localhost:5173/login
